# ==========================================
.build/
.swiftpm/configuration/
.swiftpm/xcode/

# ==========================================
# Credentials & Security (Safety Guardrails)
# ==========================================
# Never commit private keys or certificates
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
*.keystore

# Local environment/secret files (if any in the future)
.env
.env.*
secrets.json